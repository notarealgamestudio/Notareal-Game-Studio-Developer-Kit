{"rom":"moonlight-holler.gb","blobOffset":294912,"indexBytes":384,"lineLen":18,"chars":" abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789,.-:!?'>/+$","dialogs":[{"id":"SIGN_FARM","pages":[["EAST - Village","SOUTH - Owsley","Fork Lake"]]},{"id":"BOOKS","pages":[["Farmer's Almanac:","Water the crops,","shoo the crows."]]},{"id":"WELCOME","pages":[["Welcome to","Moonlight Holler,","Rebecca!"],["Hoe, water and","plant. Pet the","piggies. Have fun!"],["Stuck? Visit the","Library in the","village. East road"],["Or press START and","pick Guide any","time. Tips grow!"]]},{"id":"LIB_HELLO","pages":[["Welcome to the","Holler Library!","Ask me anything."]]},{"id":"LOCKED","pages":[["The door's locked.","Daisy's mama is","out visiting."]]},{"id":"BOARD","pages":[["NOTICE BOARD","Lost hen: answers","to Peep. Ask him."]]},{"id":"WELL","pages":[["A deep old well.","The water is cold","and sweet."]]},{"id":"CLOSED","pages":[["ROAD CLOSED","The bridge washed","out. Back soon!"]]},{"id":"CABIN","pages":[["Gus's cabin.","Nobody home. He's","fishing out back."]]},{"id":"SIGN_LAKE","pages":[["OWSLEY FORK LAKE","Fishing allowed.","Be kind to ducks."]]},{"id":"POND","pages":[["NO SWIMMING","Gus's fishing pond","Mind the dock!"]]},{"id":"SIGN_CAVE","pages":[["WHISPER MINE","Bring a pickaxe!","5th floors save."]]},{"id":"CAVE_DEEP","pages":[["Crack rocks to","find the ladder.","Beware of slimes!"]]},{"id":"CAVE_HOME","pages":[["The exit is at the","bottom of each","floor. Rocks grow."]]},{"id":"SIGN_MILL","pages":[["WEST - Old Mill","Wild piggies roam","the meadow."]]},{"id":"MILL_SIGN","pages":[["OLD HOLLER MILL","Grinds corn+hay","into pig pellets."]]},{"id":"MILL_NEED","pages":[["Needs 3 corn or","4 hay to grind","a batch."]]},{"id":"MILL_OK","pages":[["Whirr, clunk!","The stones ground","fresh pellets."]]},{"id":"PIG_SHY","pages":[["Wheek! A wild","guinea pig! It","bolts away..."]]},{"id":"PIG_NOFOOD","pages":[["It sniffs the air.","Bring a treat!","Veggies or pellets"]]},{"id":"PIG_FED","pages":[["It forgets you're","there and munches","happily."]]},{"id":"PIG_TRUST","pages":[["It trusts you now.","It nuzzles your","hand. Wheek!"]]},{"id":"PIG_HOME","pages":[["You carry it home","in a hay-lined","basket. Welcome!"]]},{"id":"PIG_WILD","pages":[["It wheeks softly","and scampers off","to the meadow."]]},{"id":"PIG_FERAL","pages":[["A feral colony","now lives here.","They leave gifts!"]]},{"id":"PIG_FULL","pages":[["Your pig book has","all of these.","Leave it wild?"]]},{"id":"GIFT_LOVE","pages":[["Oh my stars! I","love this! You","are too sweet."]]},{"id":"GIFT_LIKE","pages":[["Well, how nice!","Thank you kindly,","Rebecca."]]},{"id":"GIFT_OK","pages":[["Oh. Thanks, hon.","That's... useful.","I think."]]},{"id":"GIFT_DONE","pages":[["You already gave","me something","today, silly."]]},{"id":"EV_PEARL","pages":[["Rebecca, hon... I","never had kin to","help on the farm."],["Take this for the","piggies. You're","family now. +60g"]]},{"id":"EV_DAISY","pages":[["Y'know, you're my","best friend in","the whole Holler."],["Here, I found it","in the old mine.","Glow caps! x3"]]},{"id":"EV_WENDELL","pages":[["Never thought I'd","like a city gal,","but you're ok."],["Here's my lucky","moon seed. Plant","it with care."]]},{"id":"EV_GUS","pages":[["The lake's been","kind to me. And","so have you."],["Take this old","fossil from my","tackle box."]]},{"id":"NO_ROOM","pages":[["No room at home!","The hutch is full.","Come back soon."]]},{"id":"CH_GOOD","pages":[["Bless your heart,","Rebecca. It means","the world to me."]]},{"id":"CH_MEH","pages":[["Well... alright.","I'll think on it.","Thanks for chat."]]},{"id":"CH_BAD","pages":[["Hmph. I see.","Guess I'll manage","on my own."]]},{"id":"CH_POOR","pages":[["You pat your empty","pockets. Maybe","next time, hon."]]},{"id":"COT","pages":[["A cozy cot.","Hired hands sleep","here at night."]]},{"id":"DAISY_HIRE","pages":[["Folks say your","farm is the best","in the Holler!"],["Need a hand? I'd","work the bunkhouse","for pay. Deal?"]]},{"id":"WENDELL_HIRE","pages":[["Nice crops there.","I've got strong","arms, free time."],["I'll bunk in your","barn for a fair","wage. Shake on it?"]]},{"id":"DAISY_C_HAPPY","pages":[["Best job ever!","The bunkhouse is","so cozy."]]},{"id":"DAISY_C_OK","pages":[["Doing alright.","A radio would be","nice, though."]]},{"id":"DAISY_C_SAD","pages":[["I'm worn out...","Could we get some","comforts in here?"]]},{"id":"WENDELL_C_HAPPY","pages":[["Ha! Life is good.","Best crew in the","county."]]},{"id":"WENDELL_C_OK","pages":[["Can't complain.","Could use a bite","and a sit-down."]]},{"id":"WENDELL_C_SAD","pages":[["Plumb tuckered.","A lamp and a sofa","would help."]]},{"id":"SLEEP","pages":[["Zzz...","A new day begins","in the Holler."]]},{"id":"PEARL_INTRO","pages":[["Well hey there,","Rebecca! Welcome","to the Holler."],["Keep them piggies","and hens happy,","ya hear?"],["B changes tools, A","uses them. Hoe,","plant and water."]]},{"id":"PEARL_T1","pages":[["The arcade is all","yours, hon. Try","Dirt Road Brawler."]]},{"id":"PEARL_T2","pages":[["Air hockey is fun","after chores. Go","on, have a game."]]},{"id":"PEARL_T3","pages":[["Tuckered out? The","bed is yonder.","Sleep til sunup."]]},{"id":"PEARL_T4","pages":[["Sell extra crops","at Hobbs' store.","East trail, hon."]]},{"id":"PEARL_T5","pages":[["Mind the crows,","hon. They love","ripe cucumbers."]]},{"id":"PEARL_T6","pages":[["Pickaxe time! The","cave by the lake","grows finds daily."]]},{"id":"PEARL_T7","pages":[["START opens your","menu: bag, crew,","book and saving."]]},{"id":"HOBBS_HELLO","pages":[["Howdy! Hobbs'","General Store.","What'll it be?"]]},{"id":"DAISY_ASK","pages":[["Hi! I'm Daisy.","Mama wants to make","cucumber salad."],["Could you bring me","3 cucumbers? I'll","pay 12 gold!"]]},{"id":"DAISY_WAIT","pages":[["3 cucumbers for","Mama's salad,","please!"]]},{"id":"DAISY_DONE","pages":[["Oh thank you!","Here's 12 gold","for your trouble."]]},{"id":"DAISY_AFTER","pages":[["Mama says you grow","the best cucumbers","around!"]]},{"id":"WENDELL_ASK","pages":[["Name's Wendell.","My hens are plumb","out of corn."],["Bring me 4 ears of","corn and I'll pay","you 15 gold."]]},{"id":"WENDELL_WAIT","pages":[["Four ears of corn,","that's all I ask.","Hens are hungry!"]]},{"id":"WENDELL_DONE","pages":[["Bless you, friend!","Here's 15 gold.","Hens say thanks."]]},{"id":"WENDELL_AFTER","pages":[["Them hens are lay-","in' like crazy.","Much obliged!"]]},{"id":"GUS_T1","pages":[["Fish ain't biting.","Never do, come to","think of it."]]},{"id":"GUS_T2","pages":[["Crows after your","crops? Spray 'em","with water. Shoo!"]]},{"id":"GUS_T3","pages":[["Hold A to spray.","It wets the crops","and scares crows."]]},{"id":"GUS_T4","pages":[["Guinea pigs love","cucumber, lettuce,","peppers and hay."]]},{"id":"GUS_T5","pages":[["Chickens want corn","Feed 'em when ya","see the bubble."]]},{"id":"LORE_P1","pages":[["Rebecca, I came to","the Holler in this","trailer, years"],["back."],["Just me and my","late Clyde's old","truck. Quiet, but"],["home."]]},{"id":"LORE_P2","pages":[["Clyde named this","place Moonlight","Holler. Said the"],["moon hangs lowest","right here. On","clear nights, you"],["could pet it."]]},{"id":"LORE_P3","pages":[["Clyde kept pigs.","Said a happy piggy","is a lucky piggy."],["The wild ones out","at the windmill?","Kin to his herd,"],["I'd bet."]]},{"id":"LORE_P4","pages":[["Every fair day we","danced. Clyde","stepped on my"],["toes. Every time."],["I'd give a year of","my life to be","stepped on once"],["more, hon."]]},{"id":"LORE_P5","pages":[["I never told a","soul. Clyde buried","a tin under the"],["old windmill."],["I can't dig no","more. Spend it on","the farm, hon."],["It's yours. +150","coins"]]},{"id":"LORE_D1","pages":[["Mama runs the soup","kitchen. I'm","saving up to see"],["the ocean."],["Never seen one!","Just lakes and our","creek. Is it"],["really big?"]]},{"id":"LORE_D2","pages":[["I sneak into the","old mine","sometimes. It"],["whispers. Odd,","huh?"],["It sounds like","it's counting.","Seven... eight..."],["nine..."]]},{"id":"LORE_D3","pages":[["Mama says the","whispers are just","wind in the"],["shafts."],["But it says my","name. Only mine.","Please don't tell"],["Mama."]]},{"id":"LORE_D4","pages":[["I counted all the","way to fifty.","That's how deep"],["the mine goes!"],["At fifty it said,","come see the moon.","I got scared and"],["ran home."]]},{"id":"LORE_D5","pages":[["Will you go with","me someday? I want","to hear what it"],["says."],["Take this ruby.","It's my luck","charm. Be brave"],["for both of us."]]},{"id":"LORE_W1","pages":[["I farmed alone for","thirty years. Hens","are decent"],["company."],["They don't talk","back much. You,","though, talk right"],["at me."]]},{"id":"LORE_W2","pages":[["I used to run a","bank in the city.","Hated every minute"],["of it."],["Came here with one","suitcase and one","hen. Her name was"],["Dot."]]},{"id":"LORE_W3","pages":[["Dot lived eleven","years. Longest","living hen in the"],["county."],["Buried her under","the oak by my","coop. Don't tell"],["Hobbs I cried."]]},{"id":"LORE_W4","pages":[["That loan I took?","Bought this land.","Hobbs vouched for"],["me."],["Never forgot it.","He says he didn't","do it for money."],["Hm."]]},{"id":"LORE_W5","pages":[["I left the city","'cause I forgot","how to rest. Here"],["I remember."],["You helped,","Rebecca. Buy","yourself some fun."],["+120 coins. No","arguing."]]},{"id":"LORE_G1","pages":[["Owsley Fork Lake.","My granddad named","it after himself."],["Vain."],["The fish don't","care. They bite","when they please."],["Like cats."]]},{"id":"LORE_G2","pages":[["I collect fossils.","Dug them from the","lake bed when it"],["ran low."],["Shells big as","dinner plates. Way","up here, no sea."],["Odd."]]},{"id":"LORE_G3","pages":[["Daisy wants an","ocean. Long ago","this was all sea."],["That's my theory."],["I never told her.","A kid should find","out on her own."]]},{"id":"LORE_G4","pages":[["On still nights","the lake glows.","Not the fish. The"],["water."],["Moon in the sky,","moon in the lake.","Both look back at"],["you. Eerie."]]},{"id":"LORE_G5","pages":[["I found a stone at","the lake bottom.","Blue. Warm as"],["bread."],["Take it, Rebecca.","It hums near you.","A sapphire, I"],["think."]]},{"id":"LORE_H1","pages":[["Hobbs' General","Store. Third","generation. My"],["gran stocked it","first."],["She sold nails,","jam, and lanterns.","Mostly lanterns."],["Dark nights."]]},{"id":"LORE_H2","pages":[["Everybody owes me","a little. I like","that. It brings"],["them back."],["Folks need a","reason to say hi.","Even the grumpy"],["ones."]]},{"id":"LORE_H3","pages":[["The sign used to","say Moon Mart.","Gran got teased."],["Changed it."],["She never said why","she picked it.","She'd just wink"],["and sell a lamp."]]},{"id":"LORE_H4","pages":[["Gran kept a","ledger. Odd","entries. Moon"],["seeds, paid in","full."],["Who paid? No name.","Just a drawing of","a little round"],["hat."]]},{"id":"LORE_H5","pages":[["Take this ledger","page. Ivy can read","the old script."],["Ask her."],["And a thank you.","You made the","Holler busier."],["+200 coins. Ha!"]]},{"id":"LORE_I1","pages":[["I'm Ivy. I keep","the Library. Every","book was donated."],["Nobody remembers","who wrote half of","them. That's the"],["fun part."]]},{"id":"LORE_I2","pages":[["The oldest book is","a diary. The","Founders came by"],["wagon."],["First entry: the","sky opened and","dropped seeds."],["Moon seeds."]]},{"id":"LORE_I3","pages":[["The diary mentions","a lady who walked","down from the"],["moon."],["She asked for one","thing. A garden","that never goes to"],["sleep."]]},{"id":"LORE_I4","pages":[["Hobbs' ledger","names her too. The","same round hat,"],["drawn."],["I think she comes","back when someone","tends the moon"],["seeds."]]},{"id":"LORE_I5","pages":[["Rebecca. You tend","them. Seeds, pigs,","all of it. She"],["sees you."],["Take this. It was","in the mill,","wrapped in a round"],["hat. Moonstone."]]},{"id":"SEA_P0","pages":[["Spring! Cucumbers","and lettuce. Plant","before the crows."]]},{"id":"SEA_P1","pages":[["Hot as a skillet.","Water at dawn,","hon. Hens like"],["shade."]]},{"id":"SEA_P2","pages":[["Fall harvest, hon.","Corn and peppers.","Pie weather."]]},{"id":"SEA_P3","pages":[["Cold nights. Mind","your piggies.","Extra hay and a"],["blanket."]]},{"id":"SEA_D0","pages":[["Spring! The creek","is loud. I picked","my first leeks."]]},{"id":"SEA_D1","pages":[["Mama's pickling","all day. The house","smells like dill."]]},{"id":"SEA_D2","pages":[["Leaves everywhere!","I made a pile.","Jump in with me"],["sometime."]]},{"id":"SEA_D3","pages":[["Snow! I built a","pig out of snow.","It's kinda lumpy."]]},{"id":"SEA_W0","pages":[["Spring chicks.","Peep peep peep.","All day. I'm not"],["complaining."]]},{"id":"SEA_W1","pages":[["Hens go off lay in","this heat. Shade","and water. Mind"],["them."]]},{"id":"SEA_W2","pages":[["Corn's in. Best","crop I ever grew.","Dot would approve."]]},{"id":"SEA_W3","pages":[["Cold. My bones","talk. The hens","huddle up. Wise"],["girls."]]},{"id":"SEA_G0","pages":[["Ice is gone. The","trout are hungry","and a little dumb."]]},{"id":"SEA_G1","pages":[["Lake's warm. Carp","sulk deep. Fish","the morning, kid."]]},{"id":"SEA_G2","pages":[["Leaves float on","the water like","little boats. I"],["like it."]]},{"id":"SEA_G3","pages":[["Ice on the edge.","Fish are sleepy.","So am I. Zzz."]]},{"id":"SEA_H0","pages":[["Seed packs are","flying off","shelves. Spring"],["fever, huh?"]]},{"id":"SEA_H1","pages":[["Cold drinks sell","faster than","lanterns. Gran'd"],["be shocked."]]},{"id":"SEA_H2","pages":[["Harvest rush!","Bring your crops,","I'm buying, I'm"],["buying."]]},{"id":"SEA_H3","pages":[["Quiet season. I","read the ledger.","And nap. Mostly"],["nap."]]},{"id":"SEA_I0","pages":[["Spring cleaning at","the Library. Found","a pressed violet."]]},{"id":"SEA_I1","pages":[["Too hot to read?","Never. Sit by the","window, it's"],["breezy."]]},{"id":"SEA_I2","pages":[["Rainy fall days","are the best for","books. Come borrow"],["one."]]},{"id":"SEA_I3","pages":[["Winter reading by","the lamp. Snow on","the windows."],["Bliss."]]},{"id":"EV_HOBBS","pages":[["You buy, you chat.","You're good for","business and soul."],["Here's a bonus","from the till. +80","coins. Don't tell"],["the others."]]},{"id":"EV_IVY","pages":[["You read the","guide! You might","be my favorite"],["patron."],["Take this ruby","from the lost-and-","found. Finders"],["keepers."]]},{"id":"GIFT_OFFER","pages":[["Oh? Something for","me, Rebecca? How","kind!"]]}]}